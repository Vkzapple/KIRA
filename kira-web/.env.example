# URL backend KIRA (Go + chi + WebSocket).
# Kosongkan untuk memakai mode mock tanpa backend.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Password untuk mode mock (dipakai hanya jika NEXT_PUBLIC_API_URL kosong)
NEXT_PUBLIC_MOCK_PASSWORD=kira123

# Roboflow Workflows (dipakai server-side oleh /api/predict, jangan pakai NEXT_PUBLIC_).
# Ambil API key dari Roboflow → Settings → API Keys.
ROBOFLOW_API_KEY=

# Opsional. Kalau kosong, dipakai workflow leaf-detection-and-count milik evelly-khanza.
ROBOFLOW_WORKFLOW_URL=https://serverless.roboflow.com/evelly-khanza/workflows/leaf-detection-and-count-1795394058974
